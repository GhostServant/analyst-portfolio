---
// Hero.astro
---

<section id="about" class="hero">
  <div class="hero__background">
    <div class="hero__particles"></div>
    <div class="hero__lines">
      <div class="line line-1"></div>
      <div class="line line-2"></div>
      <div class="line line-3"></div>
      <div class="line line-4"></div>
      <div class="line line-5"></div>
      <div class="line line-6"></div>
      <div class="line line-7"></div>
      <div class="line line-8"></div>
    </div>
  </div>
  <div class="container">
    <div class="hero__content">
      <h1 class="hero__name animate-slide-up">Никита Зворыгин</h1>
      <p class="hero__title animate-slide-up" style="animation-delay: 0.1s">Стажер-системный аналитик</p>
      <p class="hero__description animate-slide-up" style="animation-delay: 0.2s">Специализируюсь на системном анализе, моделировании процессов и frontend разработке. Владею методами сбора требований, UML и BPMN диаграммами.</p>
      <a href="#projects" class="hero__cta animate-slide-up" style="animation-delay: 0.3s">Посмотреть проекты</a>
    </div>

    <!-- Блок с фото -->
    <div class="hero__photo-placeholder">
      <div class="photo-placeholder__inner">
        <p>Фото пока отсутствует — в разработке</p>
        <small>Стиль: профессиональный, технический, с акцентом на аналитику</small>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --bg-primary: #121218;
    --bg-secondary: #1a1a24;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --accent-color: #00d4aa;
    --accent-hover: #00b894;
    --radius: 8px;
    --shadow: 0 8px 32px rgba(0, 212, 170, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--bg-secondary);
    overflow: hidden;
    perspective: 1000px;
  }

  .hero__background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .hero__particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 50%, rgba(0, 212, 170, 0.4) 0%, transparent 60%),
                radial-gradient(circle at 80% 20%, rgba(0, 212, 170, 0.3) 0%, transparent 60%),
                radial-gradient(circle at 40% 80%, rgba(0, 212, 170, 0.4) 0%, transparent 60%);
    animation: float3D 6s ease-in-out infinite;
    transform-style: preserve-3d;
    filter: blur(2px);
  }

  .hero__particles::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 60% 30%, rgba(0, 212, 170, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 30% 70%, rgba(0, 212, 170, 0.3) 0%, transparent 50%);
    animation: float3D 8s ease-in-out infinite reverse;
    transform-style: preserve-3d;
  }

  .hero__particles::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 10% 10%, rgba(0, 212, 170, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 90% 90%, rgba(0, 212, 170, 0.2) 0%, transparent 40%);
    animation: float3D 10s ease-in-out infinite;
    transform-style: preserve-3d;
  }

  .hero__lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform-style: preserve-3d;
  }

  .line {
    position: absolute;
    background: linear-gradient(45deg, var(--accent-color), transparent);
    opacity: 0.6; /* Увеличено */
    animation: lineMove3D 8s linear infinite; /* Ускорено */
    box-shadow: 0 0 25px rgba(0, 212, 170, 0.6); /* Ярче */
    transform-style: preserve-3d;
    will-change: transform;
    filter: drop-shadow(0 0 6px rgba(0, 212, 170, 0.4)); /* Сильнее */
  }

  .line-1 {
    width: 200px;
    height: 2px;
    top: 20%;
    left: -200px;
    animation-delay: 0s;
    transform: rotateX(10deg) rotateY(-5deg);
  }

  .line-2 {
    width: 150px;
    height: 2px;
    top: 40%;
    right: -150px;
    animation-delay: 1.5s;
    animation-direction: reverse;
    transform: rotateX(-10deg) rotateY(5deg);
  }

  .line-3 {
    width: 100px;
    height: 2px;
    top: 60%;
    left: -100px;
    animation-delay: 3s;
    transform: rotateX(5deg) rotateY(10deg);
  }

  .line-4 {
    width: 180px;
    height: 2px;
    top: 80%;
    right: -180px;
    animation-delay: 4.5s;
    animation-direction: reverse;
    transform: rotateX(-5deg) rotateY(-10deg);
  }

  .line-5 {
    width: 120px;
    height: 2px;
    top: 10%;
    left: -120px;
    animation-delay: 6s;
    transform: rotateX(15deg) rotateY(0deg);
  }

  .line-6 {
    width: 180px;
    height: 2px;
    top: 70%;
    left: -180px;
    animation-delay: 7.5s;
    animation-direction: reverse;
    transform: rotateX(-15deg) rotateY(0deg);
  }

  .line-7 {
    width: 140px;
    height: 2px;
    top: 30%;
    right: -140px;
    animation-delay: 9s;
    transform: rotateX(0deg) rotateY(15deg);
  }

  .line-8 {
    width: 160px;
    height: 2px;
    top: 90%;
    right: -160px;
    animation-delay: 10.5s;
    animation-direction: reverse;
    transform: rotateX(0deg) rotateY(-15deg);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .hero__name {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    line-height: 1.1;
    text-shadow: 0 2px 10px rgba(0, 212, 170, 0.4); /* Ярче */
    animation: floatText 2s ease-in-out infinite; /* Частота увеличена */
  }

  .hero__title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    font-weight: 400;
    opacity: 0.9;
  }

  .hero__description {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hero__cta {
    display: inline-block;
    background: var(--accent-color);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow);
    will-change: transform, box-shadow;
  }

  .hero__cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .hero__cta:hover::before {
    left: 100%;
  }

  .hero__cta:hover {
    background: var(--accent-hover);
    transform: translateY(-3px) rotateX(5deg) scale(1.02);
    box-shadow: 0 15px 35px rgba(0, 212, 170, 0.3);
  }

  /* Блок с фото */
  .hero__photo-placeholder {
    width: 300px;
    height: 300px;
    background: #333333;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transform-style: preserve-3d;
    transform: rotateY(-10deg) rotateX(5deg);
    transition: transform 0.4s ease;
    cursor: pointer;
  }

  .hero__photo-placeholder:hover {
    transform: rotateY(0deg) rotateX(0deg) scale(1.05);
    box-shadow: 0 12px 32px rgba(0, 212, 170, 0.2);
  }

  .photo-placeholder__inner {
    color: white;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .photo-placeholder__inner p {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .photo-placeholder__inner small {
    opacity: 0.7;
    font-size: 0.8rem;
  }

  @keyframes lineMove3D {
    0% {
      transform: translateX(0) rotate(0deg) rotateX(0deg) rotateY(0deg) scale(1);
    }
    25% {
      transform: translateX(25vw) rotate(90deg) rotateX(20deg) rotateY(15deg) scale(1.1);
    }
    50% {
      transform: translateX(50vw) rotate(180deg) rotateX(0deg) rotateY(30deg) scale(1.2);
    }
    75% {
      transform: translateX(75vw) rotate(270deg) rotateX(-20deg) rotateY(15deg) scale(1.1);
    }
    100% {
      transform: translateX(100vw) rotate(360deg) rotateX(0deg) rotateY(0deg) scale(1);
    }
  }

  @keyframes float3D {
    0%, 100% { 
      transform: translateY(0px) rotateX(0deg) rotateY(0deg) scale(1);
    }
    25% {
      transform: translateY(-15px) rotateX(10deg) rotateY(10deg) scale(1.05);
    }
    50% { 
      transform: translateY(0px) rotateX(0deg) rotateY(0deg) scale(1);
    }
    75% {
      transform: translateY(15px) rotateX(-10deg) rotateY(-10deg) scale(0.95);
    }
  }

  @keyframes floatText {
    0%, 100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-3px) scale(1.01);
    }
  }

  .animate-slide-up {
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.8s ease forwards;
  }

  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Адаптивность */
  @media (max-width: 1024px) {
    .container {
      flex-direction: column;
      gap: 3rem;
      text-align: center;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero__photo-placeholder {
      width: 250px;
      height: 250px;
      transform: none;
    }

    .hero__name {
      font-size: 3rem;
    }

    .hero__title {
      font-size: 1.25rem;
    }

    .hero__description {
      font-size: 1rem;
    }

    .hero__cta {
      padding: 0.6rem 1.2rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 5rem 0;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero__name {
      font-size: 2.5rem;
    }

    .hero__title {
      font-size: 1.1rem;
    }

    .hero__description {
      font-size: 0.95rem;
    }

    .hero__cta {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }

    .hero__photo-placeholder {
      width: 200px;
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 1rem;
    }

    .hero__name {
      font-size: 2rem;
    }

    .hero__title {
      font-size: 1rem;
    }

    .hero__description {
      font-size: 0.9rem;
    }

    .hero__cta {
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }

    .hero__photo-placeholder {
      width: 150px;
      height: 150px;
    }
  }
</style>