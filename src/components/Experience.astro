---
// Experience.astro
---

<section id="experience" class="experience">
  <div class="container">
    <h2 class="section__title animate-slide-up">Опыт работы</h2>
    <p class="experience-intro animate-slide-up" style="animation-delay: 0.1s">
      Преподаватель выходного дня по курсу Frontend в Urban University (сентябрь 2024 - январь 2025)
    </p>
    <div class="experience-grid">
      <div class="experience-card" data-skill="teaching">
        <div class="experience-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
        </div>
        <h3 class="experience-title">Преподавание Frontend</h3>
        <p class="experience-description">Консультирование студентов по курсу Frontend, помощь с настройкой среды и практическими примерами.</p>
        <div class="skill-level">
          <span>Период:</span>
          <div class="skill-bar">
            <div class="skill-fill" style="width: 100%;"></div>
          </div>
          <span>5 месяцев</span>
        </div>
      </div>
      <div class="experience-card" data-skill="analysis">
        <div class="experience-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-4"></path>
            <rect x="9" y="11" width="6" height="11"></rect>
            <path d="M9 7v4"></path>
            <path d="M15 7v4"></path>
            <path d="M9 7a3 3 0 0 1 3-3h0a3 3 0 0 1 3 3v0"></path>
          </svg>
        </div>
        <h3 class="experience-title">Системный анализ</h3>
        <p class="experience-description">Сбор и документирование требований, моделирование процессов (UML, BPMN), основы SQL и структуры БД.</p>
        <div class="skill-level">
          <span>Уровень:</span>
          <div class="skill-bar">
            <div class="skill-fill" style="width: 70%;"></div>
          </div>
          <span>Хороший</span>
        </div>
      </div>
      <div class="experience-card" data-skill="frontend">
        <div class="experience-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12,6 12,12 16,14"></polyline>
          </svg>
        </div>
        <h3 class="experience-title">Frontend разработка</h3>
        <p class="experience-description">HTML/CSS, React. Использую для эффективной коммуникации с разработчиками.</p>
        <div class="skill-level">
          <span>Уровень:</span>
          <div class="skill-bar">
            <div class="skill-fill" style="width: 60%;"></div>
          </div>
          <span>Средний</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section__title {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
    text-align: center;
  }

  .experience-intro {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2.5rem;
  }

  .experience {
    padding: 3rem 0;
    background: #141020;
    position: relative;
    overflow: hidden;
  }

  .experience::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, rgba(0, 212, 170, 0.02) 0%, transparent 40%),
                radial-gradient(circle at 10% 90%, rgba(0, 212, 170, 0.03) 0%, transparent 40%);
    pointer-events: none;
    opacity: 0.6;
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .experience-card {
    background: #1e1a2a;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    transition: all 0.3s ease;
    transform-style: preserve-3d;
    perspective: 1000px;
    opacity: 0;
    transform: translateY(50px) rotateX(15deg) rotateY(10deg);
    text-align: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .experience-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 170, 0.1), transparent);
    transition: left 0.4s ease;
    z-index: 1;
  }

  .experience-card:hover::before {
    left: 100%;
  }

  .experience-card.animate-in {
    opacity: 1;
    transform: translateY(0) rotateX(0deg) rotateY(0deg);
  }

  .experience-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .experience-icon {
    width: 50px;
    height: 50px;
    background: var(--accent-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    margin: 0 auto 1rem;
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .experience-card:hover .experience-icon {
    transform: scale(1.1) rotateY(15deg);
    box-shadow: 0 8px 20px rgba(0, 212, 170, 0.3);
  }

  .experience-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.8rem;
    position: relative;
    z-index: 2;
  }

  .experience-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .skill-level {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    position: relative;
    z-index: 2;
  }

  .skill-bar {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    background: var(--accent-color);
    border-radius: 3px;
    transition: width 0.4s ease;
  }

  /* Адаптивность */
  @media (max-width: 992px) {
    .experience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .experience-grid {
      grid-template-columns: 1fr;
    }

    .section__title {
      font-size: 1.8rem;
    }

    .experience-intro {
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .experience-card {
      max-width: 500px;
      margin: 0 auto;
      padding: 1.3rem;
    }
  }

  @media (max-width: 480px) {
    .section__title {
      font-size: 1.6rem;
    }

    .experience-card {
      padding: 1.2rem;
    }

    .experience-title {
      font-size: 1rem;
    }

    .experience-description {
      font-size: 0.85rem;
    }

    .skill-level {
      flex-direction: column;
      gap: 0.4rem;
      align-items: flex-start;
    }

    .skill-bar {
      width: 100%;
    }
  }
</style>

<script>
  // Анимация при скролле
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('animate-in');
        }, index * 100);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.experience-card').forEach(card => observer.observe(card));
</script>