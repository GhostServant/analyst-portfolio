---
// Charts.astro
---

<section id="charts" class="charts">
  <div class="container">
    <h2 class="section__title animate-slide-up">Навыки и компетенции</h2>
    <div class="charts-grid">
      <!-- График навыков -->
      <div class="chart-card">
        <h3 class="chart-title">Технические навыки</h3>
        <div class="skill-chart">
          <div class="skill-item">
            <span class="skill-name">Системный анализ</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 75%;"></div>
            </div>
            <span class="skill-percent">75%</span>
          </div>
          <div class="skill-item">
            <span class="skill-name">UML диаграммы</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 70%;"></div>
            </div>
            <span class="skill-percent">70%</span>
          </div>
          <div class="skill-item">
            <span class="skill-name">BPMN моделирование</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 65%;"></div>
            </div>
            <span class="skill-percent">65%</span>
          </div>
          <div class="skill-item">
            <span class="skill-name">SQL и БД</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 60%;"></div>
            </div>
            <span class="skill-percent">60%</span>
          </div>
          <div class="skill-item">
            <span class="skill-name">HTML/CSS</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 70%;"></div>
            </div>
            <span class="skill-percent">70%</span>
          </div>
          <div class="skill-item">
            <span class="skill-name">React</span>
            <div class="skill-bar">
              <div class="skill-fill" style="width: 55%;"></div>
            </div>
            <span class="skill-percent">55%</span>
          </div>
        </div>
      </div>

      <!-- Круговая диаграмма опыта -->
      <div class="chart-card">
        <h3 class="chart-title">Опыт работы</h3>
        <div class="pie-chart">
          <div class="pie-segment" data-percent="40" data-color="#00d4aa">
            <span class="segment-label">Преподавание</span>
            <span class="segment-value">40%</span>
          </div>
          <div class="pie-segment" data-percent="35" data-color="#4ecdc4">
            <span class="segment-label">Анализ</span>
            <span class="segment-value">35%</span>
          </div>
          <div class="pie-segment" data-percent="25" data-color="#45b7d1">
            <span class="segment-label">Разработка</span>
            <span class="segment-value">25%</span>
          </div>
        </div>
      </div>

      <!-- График языков -->
      <div class="chart-card">
        <h3 class="chart-title">Языки программирования</h3>
        <div class="language-chart">
          <div class="language-item">
            <span class="language-name">JavaScript</span>
            <div class="language-bar">
              <div class="language-fill" style="width: 60%;"></div>
            </div>
            <span class="language-percent">60%</span>
          </div>
          <div class="language-item">
            <span class="language-name">SQL</span>
            <div class="language-bar">
              <div class="language-fill" style="width: 65%;"></div>
            </div>
            <span class="language-percent">65%</span>
          </div>
          <div class="language-item">
            <span class="language-name">HTML/CSS</span>
            <div class="language-bar">
              <div class="language-fill" style="width: 70%;"></div>
            </div>
            <span class="language-percent">70%</span>
          </div>
          <div class="language-item">
            <span class="language-name">Python</span>
            <div class="language-bar">
              <div class="language-fill" style="width: 40%;"></div>
            </div>
            <span class="language-percent">40%</span>
          </div>
        </div>
      </div>

      <!-- График личных качеств -->
      <div class="chart-card">
        <h3 class="chart-title">Личные качества</h3>
        <div class="qualities-chart">
          <div class="quality-item">
            <span class="quality-name">Трудолюбие</span>
            <div class="quality-stars">
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
            </div>
          </div>
          <div class="quality-item">
            <span class="quality-name">Ответственность</span>
            <div class="quality-stars">
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
            </div>
          </div>
          <div class="quality-item">
            <span class="quality-name">Терпение</span>
            <div class="quality-stars">
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star">☆</span>
            </div>
          </div>
          <div class="quality-item">
            <span class="quality-name">Готовность к обучению</span>
            <div class="quality-stars">
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
              <span class="star filled">★</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section__title {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    color: var(--text-primary);
    text-align: center;
  }

  .charts {
    padding: 3rem 0;
    background: #1a1a24;
    position: relative;
    overflow: hidden;
  }

  .charts::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 20%, rgba(0, 212, 170, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(0, 212, 170, 0.02) 0%, transparent 50%);
    pointer-events: none;
  }

  .charts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .chart-card {
    background: #1e1a2a;
    padding: 2rem;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    transition: all 0.3s ease;
    transform-style: preserve-3d;
    perspective: 1000px;
    opacity: 0;
    transform: translateY(50px) rotateX(15deg);
    overflow: hidden;
  }

  .chart-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 170, 0.1), transparent);
    transition: left 0.5s ease;
    z-index: 1;
  }

  .chart-card:hover::before {
    left: 100%;
  }

  .chart-card.animate-in {
    opacity: 1;
    transform: translateY(0) rotateX(0deg);
  }

  .chart-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  .chart-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  /* Стили для графика навыков */
  .skill-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .skill-name {
    min-width: 120px;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .skill-bar {
    flex: 1;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-color), #4ecdc4);
    border-radius: 4px;
    transition: width 1s ease;
    position: relative;
  }

  .skill-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: shimmer 2s infinite;
  }

  .skill-percent {
    min-width: 35px;
    font-size: 0.8rem;
    color: var(--accent-color);
    font-weight: 600;
  }

  /* Стили для круговой диаграммы */
  .pie-chart {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .pie-segment {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    border-left: 4px solid var(--accent-color);
  }

  .segment-label {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .segment-value {
    font-size: 0.9rem;
    color: var(--accent-color);
    font-weight: 600;
  }

  /* Стили для языков программирования */
  .language-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .language-name {
    min-width: 100px;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .language-bar {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    overflow: hidden;
  }

  .language-fill {
    height: 100%;
    background: linear-gradient(90deg, #4ecdc4, #45b7d1);
    border-radius: 3px;
    transition: width 1s ease;
  }

  .language-percent {
    min-width: 35px;
    font-size: 0.8rem;
    color: #4ecdc4;
    font-weight: 600;
  }

  /* Стили для личных качеств */
  .quality-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .quality-name {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .quality-stars {
    display: flex;
    gap: 0.2rem;
  }

  .star {
    font-size: 1.2rem;
    color: #ffd700;
    transition: all 0.3s ease;
  }

  .star.filled {
    text-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* Адаптивность */
  @media (max-width: 768px) {
    .charts-grid {
      grid-template-columns: 1fr;
    }

    .chart-card {
      padding: 1.5rem;
    }

    .section__title {
      font-size: 1.8rem;
    }

    .skill-name, .language-name {
      min-width: 100px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .skill-item, .language-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .skill-bar, .language-bar {
      width: 100%;
    }

    .quality-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  // Анимация при скролле
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('animate-in');
        }, index * 100);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.chart-card').forEach(card => observer.observe(card));
</script>
